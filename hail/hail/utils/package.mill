package build.hail.utils

import mill.T
import mill.scalalib.Dep

import build.HailScalaModule

import millbuild.BuildConfig.*
import millbuild.MvnCoordinate.*

object `package` extends HailScalaModule:

  override def compileMvnDeps: T[Seq[Dep]] =
    Vector[Dep](
      `jackson-databind` :: "2.21.2",
      `json4s-jackson` :: "4.0.7",
      `log4j-core`,
      `zstd-jni` :: "1.5.7-6",
    )

  override def mvnDeps: T[Seq[Dep]] =
    Vector[Dep](
      `log4j-api-scala`.mvn.excludeOrg("*"),
      `sourcecode` :: "0.4.2",
    )
