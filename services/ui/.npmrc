# Skip releases from the last 7 days, giving time for a compromised release to
# be noticed and unpublished before we pick it up. Requires npm >= 11.10.
min-release-age=7

# Fail the install if a dependency has an install script that isn't approved or
# denied in package.json's allowScripts. Review new ones with
# `npm approve-scripts --allow-scripts-pending`.
strict-allow-scripts=true
